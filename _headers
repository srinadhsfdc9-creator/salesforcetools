  Content-Security-Policy: default-src 'self' 'unsafe-inline' data:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; img-src 'self' data: blob: https://cdn.razorpay.com https://lh3.googleusercontent.com https://*.googleusercontent.com; connect-src 'self' https://sfproxy.chsrinadhch.workers.dev https://api.anthropic.com https://api.razorpay.com https://lumberjack.razorpay.com https://oauth2.googleapis.com https://accounts.google.com https://api.web3forms.com; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://static.cloudflareinsights.com https://accounts.google.com https://apis.google.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://accounts.google.com; object-src 'none'; base-uri 'self'

/og-image.png
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400

/sitemap.xml
